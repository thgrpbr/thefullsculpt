Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
</IfModule>
<FilesMatch "\.(sql|md|inc|log)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set Cache-Control "no-store"
</IfModule>
